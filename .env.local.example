# スタッフの疑似ログイン用メールドメイン（Supabase Authのemail制約対応・内部専用）
STAFF_AUTH_EMAIL_DOMAIN=staff.dousen-work.invalid

# 段階実装（Phase 5以降で使用）
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
