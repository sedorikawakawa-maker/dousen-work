# =============================================================================
# 公開可能（ブラウザに露出してよい値のみ）。NEXT_PUBLIC_ プレフィックス必須。
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
# Supabaseの新しいキー命名（publishable key）。ダッシュボードの
# Project Settings > API Keys に表示される値をそのまま使用する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# サーバー専用（絶対にブラウザへ露出させない・NEXT_PUBLIC_を付けない）
# Server Action / Route Handler 以外からimportしないこと。
# =============================================================================

# Supabase service_role（RLSを全てバイパスする。公開フォーム(素材/外注)の
# service_role経由書き込みと、スタッフ作成CLIでのみ使用）
SUPABASE_SERVICE_ROLE_KEY=

# スタッフの疑似ログイン用メールドメイン（Supabase Authのemail制約対応・内部専用。
# ログイン画面や通知など、スタッフに見せる場所には一切使用しない）
STAFF_AUTH_EMAIL_DOMAIN=staff.dousen-work.invalid

# Google Drive OAuth クライアント情報（Google Cloud Consoleで作成したOAuthクライアント
# のID/シークレット。取得時はそのまま貼り付け、絶対にリポジトリへコミットしないこと）。
# refresh tokenはここには置かない。DOUSEN WORK管理画面「システム設定 → Google Drive連携」
# から接続すると、暗号化された状態でSupabase側(drive_integrationテーブル)に保存される。
# 未設定の間は開発環境でのみMockDriveServiceが使われる（本番ではフォールバックしない）。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# refresh token暗号化鍵（32バイトをbase64で。生成例: openssl rand -base64 32）。
# この鍵自体はDBに保存せず、環境変数としてのみ管理する。
DRIVE_TOKEN_ENCRYPTION_KEY=

# 素材フォーム・外注アップロードフォームのトークンは crypto.randomBytes で
# 都度生成しDBにはhashのみ保存するため、署名用のシークレットは不要。
