# =============================================================================
# 公開可能（ブラウザに露出してよい値のみ）。NEXT_PUBLIC_ プレフィックス必須。
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# サーバー専用（絶対にブラウザへ露出させない・NEXT_PUBLIC_を付けない）
# Server Action / Route Handler 以外からimportしないこと。
# =============================================================================

# Supabase service_role（RLSを全てバイパスする。公開フォーム(素材/外注)の
# service_role経由書き込みと、スタッフ作成CLIでのみ使用）
SUPABASE_SERVICE_ROLE_KEY=

# スタッフの疑似ログイン用メールドメイン（Supabase Authのemail制約対応・内部専用。
# ログイン画面や通知など、スタッフに見せる場所には一切使用しない）
STAFF_AUTH_EMAIL_DOMAIN=staff.dousen-work.invalid

# Google Drive OAuth（実DriveService実装時に使用。未設定の間はMockDriveServiceが
# 使われ、これらの値は参照されない。取得時はGoogle Cloud ConsoleのOAuthクライアント
# シークレットをそのまま貼り付け、絶対にリポジトリへコミットしないこと）
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# 素材フォーム・外注アップロードフォームのトークンは crypto.randomBytes で
# 都度生成しDBにはhashのみ保存するため、署名用のシークレットは不要。
