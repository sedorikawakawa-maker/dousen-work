# クライアント/サーバー共通で公開可能な値
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用（絶対にブラウザへ露出させない・NEXT_PUBLIC_を付けない）
